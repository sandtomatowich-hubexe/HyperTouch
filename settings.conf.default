# HyperTouch settings.
# Edit from the WebUI (recommended), or by hand — most changes apply
# immediately via "Apply now" / the Action button, no reboot needed.
# Exceptions are noted per key below.

# ── Sampling ──────────────────────────────────────────────
# Touch report rate: 0 = stock, 1 = boosted
REPORT_RATE_MODE=1

# ── System ────────────────────────────────────────────────
# Disable MIUI/HyperOS PowerKeeper background throttling: 0 or 1
DISABLE_POWERKEEPER=1

# Spoof battery temp sensor to 25.0C to dodge thermal throttling.
# OFF by default: this hides real overheating from the system. Only
# enable it if you understand the risk.
SPOOF_BATTERY_TEMP=0

# ── Touch tuning (kernel-dependent, pending device data) ───
# Leave blank until confirmed via tools/probe_touch.sh — see README.
TOUCH_SENSITIVITY_PATH=
TOUCH_SENSITIVITY_VALUE=
TOUCH_EDGE_PATH=
TOUCH_EDGE_VALUE=
PALM_REJECT_PATH=
PALM_REJECT_VALUE=

# ── Smooth Touch (userspace, kernel-independent) ────────────
# Scales system animation durations via the Settings provider.
# 0 = stock (1.0x), 1 = fast (0.5x), 2 = instant (0x — no animations)
SMOOTH_TOUCH_MODE=1

# ── Priority Apps (userspace, kernel-independent) ───────────
# Space-separated package names exempted from Doze / App Standby /
# PowerKeeper background limits. Reduces background-throttle-induced
# jank (e.g. scroll stutter after the app's been backgrounded a while).
# NOTE: this changes background execution limits, not rendering
# internals — it's the only safe userspace lever for this, not a
# guaranteed fix for any specific app's scroll performance.
PRIORITY_APPS=

# Convenience preset: adds org.telegram.messenger to PRIORITY_APPS.
# Experimental — see README for what this does and doesn't address.
TG_LAG_FIX=0

# ── WebUI ─────────────────────────────────────────────────
# UI_STYLE: material | miui
UI_STYLE=material

# ── Internal — do not edit ───────────────────────────────────
CONF_VERSION=2
